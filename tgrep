#!/usr/bin/env zsh
# Usage: tgrep '<regex>'
# Search ./en case-insensitively and preview the same lines in matching files under ./ko and ./ja with fzf.
# Example: TGREP_DOCS_DIR=./docs TGREP_ORIGIN_LANG=en TGREP_TARGET_LANGS=ko,ja tgrep 'sign in'

set -euo pipefail

# Environment variables take precedence over the user's zsh config.
DOCS_DIR="${TGREP_DOCS_DIR:-}"
ORIGIN_LANG="${TGREP_ORIGIN_LANG:-}"
TARGET_LANGS_RAW="${TGREP_TARGET_LANGS:-}"
ENTER_ACTION="${TGREP_ENTER_ACTION:-}"
typeset -A context_env=()
if [[ "${1:-}" != --_preview && "${1:-}" != --_compare && -f "$HOME/.config/tgrep/config" ]]; then
  for key in ${(k)parameters[(I)TGREP_(BEFORE|AFTER)_LINES*]}; do
    context_env[$key]="${(P)key}"
  done
  source "$HOME/.config/tgrep/config"
fi

DOCS_DIR="${DOCS_DIR:-${TGREP_DOCS_DIR:-.}}"
DOCS_DIR="${DOCS_DIR/#\~/$HOME}"
ORIGIN_LANG="${ORIGIN_LANG:-${TGREP_ORIGIN_LANG:-en}}"
TARGET_LANGS_RAW="${TARGET_LANGS_RAW:-${TGREP_TARGET_LANGS:-ko,ja}}"
ENTER_ACTION="${ENTER_ACTION:-${TGREP_ENTER_ACTION:-edit}}"
if [[ "$ENTER_ACTION" != edit && "$ENTER_ACTION" != print ]]; then
  print -u2 -r -- "Error: TGREP_ENTER_ACTION must be 'edit' or 'print' (got '$ENTER_ACTION')."
  exit 1
fi

# Split comma-separated target languages into an array
typeset -a TARGET_LANGS=()
for lang in "${(@s:,:)TARGET_LANGS_RAW}"; do
  lang="${lang//[[:space:]]/}"
  [[ -n "$lang" ]] && TARGET_LANGS+=("$lang")
done

is_nonnegative_integer() {
  [[ -n "$1" && "$1" != *[!0-9]* ]]
}

# Resolve each language's preview settings before launching fzf.
typeset -A context_lines=()
for lang in "$ORIGIN_LANG" "${TARGET_LANGS[@]}"; do
  for side in BEFORE AFTER; do
    base="TGREP_${side}_LINES"
    key="${base}_${${lang:u}//[^A-Z0-9_]/_}"
    fallback="${context_env[$base]:-${${(P)base}:-3}}"
    count="${context_env[$key]:-${${(P)key}:-$fallback}}"
    if ! is_nonnegative_integer "$count"; then
      print -u2 -r -- "Error: $base and $key must be nonnegative integers (got '$count' for '$lang')."
      exit 1
    fi
    context_lines[$side/$lang]="$count"
    export "$key=$count"
  done
done

ORIGIN_DIR="${DOCS_DIR%/}/${ORIGIN_LANG}"
use_git=0
if (( $+commands[git] )) && [[ "$(git -C "$DOCS_DIR" rev-parse --is-inside-work-tree 2>/dev/null)" == true ]]; then
  use_git=1
fi

# BSD grep uses GREP_COLOR. GNU grep also lets us clear filename and separator colors.
export GREP_COLOR='1;31' GREP_COLORS='ms=1;31:mc=1;31:fn=:ln=:se='

# All views should use the same set of translations.
has_translation() {
  [[ -f "${DOCS_DIR%/}/$1/$2" ]] &&
    { (( ! use_git )) || ! git -C "$DOCS_DIR" check-ignore -q -- "$1/$2"; }
}

# The parent fzf resumes at the same result when the comparison closes.
if [[ "${1:-}" == --_compare ]]; then
  (( $+commands[vim] )) || exit 0
  index="$2"
  rel_path="${3#./}"
  line="$4"
  lang="${TARGET_LANGS[$index]:-}"
  if [[ -z "$lang" ]]; then
    message="Target language $index is not configured."
  elif ! has_translation "$lang" "$rel_path"; then
    message="No translation available for $lang/$rel_path."
  else
    is_nonnegative_integer "$line" || exit 1
    cd -- "$DOCS_DIR"
    # Keep the original lines for independent reading. Only the linked view
    # pads short files and wrapped rows, and all padding stays in memory.
    exec vim -u NONE -i NONE -n -m -O \
      --cmd 'set nocompatible nomodeline ttimeout ttimeoutlen=80 shortmess+=F' \
      -c 'set showtabline=2 laststatus=2 undolevels=-1' \
      -c 'let rows = max(map(getbufinfo({"bufloaded": 1}), "v:val.linecount"))' \
      -c 'windo setlocal wrap nolinebreak nofoldenable number cursorline | let b:source_lines = getline(1, "$")' \
      -c 'function! MeasureWrap()
            let &l:numberwidth = max([4, strlen(g:rows) + 1])
            let info = getwininfo(win_getid())[0]
            let w:columns = max([1, info.width - info.textoff])
            let w:cells = map(copy(b:source_lines), "strdisplaywidth(v:val)")
            let w:cells += repeat([0], g:rows - len(w:cells))
            let w:continuations = map(copy(w:cells), "(max([1, v:val]) - 1) / w:columns")
          endfunction
          function! SetViewLines(lines)
            let view = winsaveview()
            setlocal modifiable noreadonly
            call setline(1, a:lines)
            if line("$") > len(a:lines)
              call deletebufline(bufnr(), len(a:lines) + 1, "$")
            endif
            setlocal nomodified nomodifiable readonly
            call winrestview(view)
          endfunction
          function! PadWrap()
            let other = getwinvar(3 - winnr(), "continuations")
            let lines = b:source_lines + repeat([""], g:rows - len(b:source_lines))
            for i in range(len(lines))
              if other[i] > w:continuations[i]
                let lines[i] .= repeat(" ", other[i] * w:columns + 1 - w:cells[i])
              endif
            endfor
            call SetViewLines(lines)
          endfunction
          function! AlignWrap()
            for pane in [1, 2]
              call win_execute(win_getid(pane), "call MeasureWrap()")
            endfor
            for pane in [1, 2]
              call win_execute(win_getid(pane), "call PadWrap()")
            endfor
          endfunction' \
      -c 'wincmd t' \
      -c 'function! MirrorView()
            let other = winnr() == 1 ? 2 : 1
            call win_execute(win_getid(other), "call winrestview(" . string(winsaveview()) . ")")
          endfunction
          function! SetScrollMode(linked)
            let g:linked_scroll = a:linked
            if a:linked
              let &tabline = " Linked · s to unlink · ↑/↓ PgUp/PgDn · Esc to return"
              call AlignWrap()
              call MirrorView()
            else
              let &tabline = " Independent · s to link · ←/→ select pane · Esc to return"
              for pane in [1, 2]
                call win_execute(win_getid(pane), "call SetViewLines(b:source_lines)")
              endfor
            endif
          endfunction
          call SetScrollMode(1)
          autocmd VimEnter,CursorMoved,WinScrolled * if g:linked_scroll | call MirrorView() | endif
          autocmd VimResized * if g:linked_scroll | call AlignWrap() | call MirrorView() | endif' \
      -c "normal! ${line}Gzz" \
      -c 'nnoremap <silent> s :call SetScrollMode(!g:linked_scroll)<CR>
          nnoremap <Left> <C-W>h
          nnoremap <Right> <C-W>l
          nnoremap <Up> gk
          nnoremap <Down> gj
          nnoremap <Esc> :qa!<CR>' \
      -- "$ORIGIN_LANG/$rel_path" "$lang/$rel_path" </dev/tty >/dev/tty
  fi
  print -r -- "$message" | FZF_DEFAULT_OPTS= FZF_DEFAULT_OPTS_FILE= fzf \
    --layout=reverse --border --margin=1,2 --header='Esc to return' >/dev/null
  exit
fi

# Internal preview mode invoked by fzf
if [[ "${1:-}" == "--_preview" ]]; then
  rel_path="${2#./}"
  origin_file="$ORIGIN_DIR/$rel_path"
  line="$3"
  query="${TGREP_QUERY:-}"
  before="${context_lines[BEFORE/$ORIGIN_LANG]}"
  after="${context_lines[AFTER/$ORIGIN_LANG]}"

  # Print origin snippet with query highlighted in red bold
  echo "=== ${ORIGIN_LANG:u} (${ORIGIN_LANG}/${rel_path}:${line}) ==="
  # The empty end-of-line match keeps context lines visible without coloring them.
  awk -v target="$line" -v b="$before" -v a="$after" '
    NR > target + a { exit }
    NR >= target - b { print }
  ' "$origin_file" |
    grep -Ei --color=always -e "$query" -e '$' |
    awk -v b="$before" -v target="$line" 'BEGIN { s = target > b ? target - b : 1 } {
      n = s + NR - 1
      printf "%s %4d | %s\n", (n == target ? ">" : " "), n, $0
    }'

  # Print matching snippets for all existing target language files
  for lang in "${TARGET_LANGS[@]}"; do
    target_file="${DOCS_DIR%/}/${lang}/${rel_path}"
    if has_translation "$lang" "$rel_path"; then
      echo ""
      echo "=== ${lang:u} (${lang}/${rel_path}:${line}) ==="
      awk -v b="${context_lines[BEFORE/$lang]}" -v a="${context_lines[AFTER/$lang]}" -v target="$line" '
        NR > target + a { exit }
        NR >= target - b {
          if (NR == target) printf "\033[1;33m> %4d | %s\033[0m\n", NR, $0
          else              printf "  %4d | %s\n", NR, $0
        }
      ' "$target_file"
    fi
  done
  exit 0
fi

# Main search mode
query="${1:-}"
if [[ -z "$query" ]]; then
  echo "Usage: $(basename "$0") <query>" >&2
  exit 1
fi

if [[ ! -d "$ORIGIN_DIR" ]]; then
  echo "Error: Origin directory not found: $ORIGIN_DIR" >&2
  exit 1
fi

# List paths relative to a language directory, keeping filenames NUL-delimited.
list_files() (
  cd -- "$1" || return 1
  if (( use_git )); then
    git ls-files -z --cached --others --exclude-standard -- .
  else
    printf '%s\0' **/*(.N)
  fi
)

typeset -A translated_paths=()
typeset -a origin_files=()

for lang in "${TARGET_LANGS[@]}"; do
  target_dir="${DOCS_DIR%/}/${lang}"
  [[ ! -d "$target_dir" ]] && continue

  while IFS= read -r -d '' rel_path; do
    [[ -f "$target_dir/$rel_path" ]] && translated_paths[$rel_path]=1
  done < <(list_files "$target_dir")
done

while IFS= read -r -d '' rel_path; do
  [[ -n "$rel_path" && "/$rel_path" != */.* && -n "${translated_paths[$rel_path]:-}" ]] || continue
  # grep treats a bare dash as standard input, even after --.
  [[ "$rel_path" == - ]] && rel_path=./-
  [[ -f "$ORIGIN_DIR/$rel_path" ]] && origin_files+=("$rel_path")
done < <(list_files "$ORIGIN_DIR")

if (( ${#origin_files[@]} == 0 )); then
  echo "Error: No matching files found between '$ORIGIN_LANG' and '$TARGET_LANGS_RAW' in '$DOCS_DIR'." >&2
  exit 1
fi

SCRIPT_PATH="${0:A}"
pick_match() {
  if (( $+commands[vim] )); then
    set -- "$@" --header='F1 / F2 · compare side by side' \
      --bind 'f1:execute("$TGREP_SCRIPT_PATH" --_compare 1 {1} {2})' \
      --bind 'f2:execute("$TGREP_SCRIPT_PATH" --_compare 2 {1} {2})'
  fi
  (
    cd -- "${ORIGIN_DIR:a}"
    # Pass fence lines through grep even when the query only matches their contents.
    local fence_pattern='^ ? ? ?```+[^`]*$'
    grep -EinHI --null -e "$query" -e "$fence_pattern" -- "${origin_files[@]}" |
      tr '\000' '\037' | awk -v sep=$'\037' -v fence_pattern="$fence_pattern" '{
        split_at = index($0, sep)
        file = substr($0, 1, split_at - 1)
        if (file != last_file) {
          fence_width = 0
          last_file = file
        }
        hit = substr($0, split_at + 1)
        colon = index(hit, ":")
        content = substr(hit, colon + 1)
        if (content ~ fence_pattern) {
          sub(/^ */, "", content)
          match(content, /^`+/)
          if (!fence_width) fence_width = RLENGTH
          else if (RLENGTH >= fence_width && substr(content, RLENGTH + 1) ~ /^[ \t]*\r?$/) fence_width = 0
          next
        }
        if (!fence_width) print file sep substr(hit, 1, colon - 1) sep content
      }' || {
      rc=$?
      # fzf can close its input as soon as the user selects a result.
      (( rc == 141 )) || exit "$rc"
    }
  ) | TGREP_SCRIPT_PATH="$SCRIPT_PATH" TGREP_QUERY="$query" \
    TGREP_DOCS_DIR="$DOCS_DIR" TGREP_ORIGIN_LANG="$ORIGIN_LANG" TGREP_TARGET_LANGS="$TARGET_LANGS_RAW" \
    fzf -i --ansi --delimiter=$'\037' --with-nth='{1}:{2}' \
      --preview '"$TGREP_SCRIPT_PATH" --_preview {1} {2}' \
      --preview-window 'up:65%:wrap' "$@"
}

if [[ "$ENTER_ACTION" == print ]]; then
  pick_match --accept-nth='{1}:{2}:{3..}' | while IFS= read -r match; do
    printf '%s/%s\n' "$ORIGIN_DIR" "${match#./}"
  done
  exit
fi

selection=$(pick_match +m --accept-nth='{2}:{1}')
line="${selection%%:*}"
rel_path="${selection#*:}"
is_nonnegative_integer "$line" && [[ -n "$rel_path" ]] || exit 1
for lang in "${TARGET_LANGS[@]}"; do
  has_translation "$lang" "$rel_path" || continue
  editor="${EDITOR:-vi}"
  if [[ -f "$editor" && -x "$editor" ]]; then
    editor_args=("$editor")
  else
    # Respect quoted editor options without evaluating shell code.
    editor_args=( "${(@Q)${(z)editor}}" )
  fi
  target_file="${DOCS_DIR:a}/$lang/$rel_path"
  case "${editor_args[1]:t}" in
    vi|vim|gvim|nvim|nano|emacs|emacsclient)
      exec "${editor_args[@]}" "+$line" "$target_file" ;;
    code|code-insiders|codium|cursor)
      exec "${editor_args[@]}" --goto "${target_file}:${line}:1" ;;
    *)
      exec "${editor_args[@]}" "$target_file" ;;
  esac
done
print -u2 -r -- "Error: No translation available for '$rel_path' in '$TARGET_LANGS_RAW'."
exit 1
